{
  "version": 4,
  "configurePresets": [
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "ALTERHOOK_TARGET_ARCH": "X86",
        "CMAKE_CXX_STANDARD": "20"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
        }
      }
    },
    {
      "name": "linux-x64-base",
      "hidden": true,
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "linux-gcc-x64"
        }
      }
    },
    {
      "name": "linux-x86-base",
      "hidden": true,
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "environment": {
        "CFLAGS": "-m32",
        "CXXFLAGS": "-m32",
        "LDFLAGS": "-m32"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "linux-gcc-x86"
        }
      }
    },
    {
      "name": "linux-gcc-base",
      "hidden": true,
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-gcc-x64",
      "displayName": "Linux GCC x64 Static Library",
      "inherits": [
        "linux-gcc-base",
        "linux-x64-base"
      ]
    },
    {
      "name": "linux-gcc-x86",
      "displayName": "Linux GCC x86 Static Library",
      "inherits": [
        "linux-gcc-base",
        "linux-x86-base"
      ]
    },
    {
      "name": "linux-clang-base",
      "hidden": true,
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-clang-x64",
      "displayName": "Linux Clang x64 Static Library",
      "inherits": [
        "linux-clang-base",
        "linux-x64-base"
      ]
    },
    {
      "name": "linux-clang-x86",
      "displayName": "Linux Clang x86 Static Library",
      "inherits": [
        "linux-clang-base",
        "linux-x86-base"
      ]
    },
    {
      "name": "linux-so",
      "hidden": true,
      "cacheVariables": {
        "ALTERHOOK_SHARED": "ON"
      }
    },
    {
      "name": "linux-gcc-x64-so",
      "displayName": "Linux GCC x64 Shared Library",
      "inherits": [
        "linux-gcc-x64",
        "linux-so"
      ]
    },
    {
      "name": "linux-gcc-x86-so",
      "displayName": "Linux GCC x86 Shared Library",
      "inherits": [
        "linux-gcc-x86",
        "linux-so"
      ]
    },
    {
      "name": "linux-clang-x64-so",
      "displayName": "Linux Clang x64 Shared Library",
      "inherits": [
        "linux-clang-x64",
        "linux-so"
      ]
    },
    {
      "name": "linux-clang-x86-so",
      "displayName": "Linux Clang x86 Shared Library",
      "inherits": [
        "linux-clang-x86",
        "linux-so"
      ]
    }
  ]
}
