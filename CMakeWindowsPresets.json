{
  "version": 4,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "ALTERHOOK_TARGET_ARCH": "X86",
        "CMAKE_CXX_STANDARD": "20"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-x64",
      "displayName": "Windows MSVC x64 Static Library",
      "inherits": "windows-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "windows-msvc-x86",
      "displayName": "Windows MSVC x86 Static Library",
      "inherits": "windows-msvc-x64",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "windows-clang-x64",
      "displayName": "Windows Clang x64 Static Library",
      "inherits": "windows-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_CXX_COMPILER": "clang-cl.exe"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "windows-clang-x86",
      "displayName": "Windows Clang x86 Static Library",
      "inherits": "windows-clang-x64",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "environment": {
        "CC": "clang-cl",
        "CFLAGS": "-m32",
        "CXX": "clang-cl",
        "CXXFLAGS": "-m32",
        "LDFLAGS": "-m32"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x86"
        }
      }
    },
    {
      "name": "windows-dll",
      "hidden": true,
      "cacheVariables": {
        "ALTERHOOK_SHARED": "ON"
      }
    },
    {
      "name": "windows-msvc-x64-dll",
      "displayName": "Windows MSVC x64 Dynamic Library",
      "inherits": [ "windows-msvc-x64", "windows-dll" ]
    },
    {
      "name": "windows-msvc-x86-dll",
      "displayName": "Windows MSVC x86 Dynamic Library",
      "inherits": [ "windows-msvc-x86", "windows-dll" ]
    },
    {
      "name": "windows-clang-x64-dll",
      "displayName": "Windows Clang x64 Dynamic Library",
      "inherits": [ "windows-clang-x64", "windows-dll" ]
    },
    {
      "name": "windows-clang-x86-dll",
      "displayName": "Windows Clang x86 Dynamic Library",
      "inherits": [ "windows-clang-x86", "windows-dll" ]
    }
  ],
  "testPresets": [
    {
      "name": "test-windows-dll",
      "displayName": "Windows DLL test",
      "configurePreset": "windows-msvc-x64-dll",
      "output": { "outputOnFailure": true },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "test-clang-windows-dll",
      "displayName": "Windows Clang DLL test",
      "configurePreset": "windows-clang-x64-dll",
      "output": { "outputOnFailure": true },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "test-x86-windows-dll",
      "displayName": "Windows x86 DLL test",
      "configurePreset": "windows-msvc-x86-dll",
      "output": { "outputOnFailure": true },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "test-clang-x86-windows-dll",
      "displayName": "Windows Clang x86 DLL test",
      "configurePreset": "windows-clang-x86-dll",
      "output": { "outputOnFailure": true },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    }
  ]
}
